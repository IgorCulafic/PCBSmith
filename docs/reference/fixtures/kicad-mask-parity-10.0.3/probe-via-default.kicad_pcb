(kicad_pcb
  (version 20240108)
  (generator "PCBSmith-mask-parity-probe")
  (general (thickness 1.6))
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user)
    (33 "F.Adhes" user)
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user)
    (37 "F.SilkS" user)
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (44 "Edge.Cuts" user)
  )
  (setup (pad_to_mask_clearance 0.2))
  (footprint "F-Probe"
    (layer "F.Cu")
    (at 0 0)
    (attr smd)
    (pad "C_DEF" smd circle (at 10 10) (size 2 2)
      (layers "F.Cu" "F.Paste" "F.Mask"))
    (pad "C_LOCAL" smd circle (at 20 10) (size 2 2)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (solder_mask_margin 0.4))
    (pad "C_RATIO" smd circle (at 30 10) (size 2 2)
      (layers "F.Cu" "F.Paste" "F.Mask"))
    (pad "C_BOTH" smd circle (at 40 10) (size 2 2)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (solder_mask_margin 0.1))

    (pad "O_DEF" smd oval (at 10 20) (size 4 2)
      (layers "F.Cu" "F.Paste" "F.Mask"))
    (pad "O_LOCAL" smd oval (at 20 20) (size 4 2)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (solder_mask_margin 0.4))
    (pad "O_RATIO" smd oval (at 30 20) (size 4 2)
      (layers "F.Cu" "F.Paste" "F.Mask"))
    (pad "O_BOTH" smd oval (at 40 20) (size 4 2)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (solder_mask_margin 0.1))

    (pad "R_DEF" smd rect (at 10 30) (size 4 2)
      (layers "F.Cu" "F.Paste" "F.Mask"))
    (pad "R_LOCAL" smd rect (at 20 30) (size 4 2)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (solder_mask_margin 0.4))
    (pad "R_RATIO" smd rect (at 30 30) (size 4 2)
      (layers "F.Cu" "F.Paste" "F.Mask"))
    (pad "R_BOTH" smd rect (at 40 30) (size 4 2)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (solder_mask_margin 0.1))

    (pad "RR_DEF" smd roundrect (at 10 40) (size 4 2)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (roundrect_rratio 0.25))
    (pad "RR_LOCAL" smd roundrect (at 20 40) (size 4 2)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (roundrect_rratio 0.25)
      (solder_mask_margin 0.4))
    (pad "RR_RATIO" smd roundrect (at 30 40) (size 4 2)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (roundrect_rratio 0.25))
    (pad "RR_BOTH" smd roundrect (at 40 40) (size 4 2)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (roundrect_rratio 0.25)
      (solder_mask_margin 0.1))

    (pad "NO_FMASK" smd circle (at 50 10) (size 2 2)
      (layers "F.Cu" "F.Paste"))
    (pad "C_ZERO" smd circle (at 50 20) (size 2 2)
      (layers "F.Cu" "F.Mask")
      (solder_mask_margin 0))
    (pad "C_NEG" smd circle (at 60 20) (size 2 2)
      (layers "F.Cu" "F.Mask")
      (solder_mask_margin -0.2))
    (pad "WEB1" smd circle (at 70 40) (size 1 1)
      (layers "F.Cu" "F.Mask"))
    (pad "WEB2" smd circle (at 71.5 40) (size 1 1)
      (layers "F.Cu" "F.Mask"))
  )

  (footprint "F-Rot-Probe"
    (layer "F.Cu")
    (at 85 20 90)
    (attr smd)
    (pad "F_DEF" smd rect (at 0 0) (size 4 2)
      (layers "F.Cu" "F.Mask"))
    (pad "F_LOCAL" smd oval (at 10 0 30) (size 4 2)
      (layers "F.Cu" "F.Mask")
      (solder_mask_margin 0.4))
  )

  (footprint "B-Probe"
    (layer "B.Cu")
    (at 70 20 90)
    (attr smd)
    (pad "B_DEF" smd rect (at 0 0) (size 4 2)
      (layers "B.Cu" "B.Paste" "B.Mask"))
    (pad "B_LOCAL" smd oval (at 10 0 30) (size 4 2)
      (layers "B.Cu" "B.Paste" "B.Mask")
      (solder_mask_margin 0.4))
    (pad "B_NO_MASK" smd circle (at 20 0) (size 2 2)
      (layers "B.Cu" "B.Paste"))
  )

  (footprint "THT-Probe"
    (layer "F.Cu")
    (at 0 0)
    (attr through_hole)
    (pad "T_BOTH" thru_hole circle (at 60 55) (size 2 2) (drill 1)
      (layers "*.Cu" "*.Mask"))
    (pad "T_FRONT" thru_hole circle (at 70 55) (size 2 2) (drill 1)
      (layers "*.Cu" "F.Mask"))
    (pad "T_BACK" thru_hole circle (at 80 55) (size 2 2) (drill 1)
      (layers "*.Cu" "B.Mask"))
    (pad "T_NONE" thru_hole circle (at 90 55) (size 2 2) (drill 1)
      (layers "*.Cu"))
  )

  (via (at 10 55) (size 2) (drill 1) (layers "F.Cu" "B.Cu") (net 0))
  (via (at 20 55) (size 2) (drill 1) (layers "F.Cu" "B.Cu")
    (tenting (front yes) (back yes)) (net 0))
  (via (at 30 55) (size 2) (drill 1) (layers "F.Cu" "B.Cu")
    (tenting (front no) (back no)) (net 0))
  (via (at 40 55) (size 2) (drill 1) (layers "F.Cu" "B.Cu")
    (tenting (front yes) (back no)) (net 0))
  (via (at 50 55) (size 2) (drill 1) (layers "F.Cu" "B.Cu")
    (tenting (front no) (back yes)) (net 0))

  (gr_rect (start 0 0) (end 100 70)
    (stroke (width 0.1) (type default)) (fill none) (layer "Edge.Cuts"))
)
